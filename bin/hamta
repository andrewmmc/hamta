#!/usr/bin/env bash
set -euo pipefail

VERSION="1.2.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hamta"
CONFIG_FILE="$CONFIG_DIR/config.json"
PROXYCHAINS_CONFIG=""
NO_PROXY_CONFIG=""

# Addresses that must always bypass the proxy so that connections to local
# services (dev servers, databases, etc.) are not routed through it.
DEFAULT_NO_PROXY="localhost,127.0.0.1,::1"
DEFAULT_LOCALNET="127.0.0.0/255.0.0.0 10.0.0.0/255.0.0.0 172.16.0.0/255.240.0.0 192.168.0.0/255.255.0.0 ::1/128"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

usage() {
    cat <<EOF
hamta - Run commands through a proxy environment.

Usage: hamta [--mode env|proxychains] [--] <command> [args...]
        hamta --help
        hamta --version
        hamta config
        hamta doctor
        hamta verify

Options:
  --mode MODE  Override configured mode for this command only
  --help      Show this help message
  --version   Show version
  config      Print current configuration
  doctor      Check dependencies, config, proxy reachability, and exit IP
  init        Create default config at ~/.config/hamta/config.json
  verify      Test proxy verification without running a command

Config file: ~/.config/hamta/config.json
EOF
    exit 0
}

die() {
    echo -e "${RED}Error:${NC} $*" >&2
    exit 1
}

warn() {
    echo -e "${YELLOW}Warning:${NC} $*" >&2
}

doctor_ok() {
    echo -e "${GREEN}OK:${NC} $*"
}

doctor_warn() {
    echo -e "${YELLOW}WARN:${NC} $*"
}

doctor_fail() {
    echo -e "${RED}FAIL:${NC} $*" >&2
}

check_deps() {
    local missing=()
    if ! command -v jq &>/dev/null; then
        missing+=("jq")
    fi
    if ! command -v curl &>/dev/null; then
        missing+=("curl")
    fi
    if [[ ${#missing[@]} -gt 0 ]]; then
        die "Missing required dependencies: ${missing[*]}. Install them and try again."
    fi
}

default_config_src() {
    local script="$0"
    local dir
    local target

    if [[ "$script" != */* ]]; then
        script="$(command -v "$script")"
    fi

    while [[ -L "$script" ]]; do
        dir="$(cd -P "$(dirname "$script")" >/dev/null 2>&1 && pwd)"
        target="$(readlink "$script")"
        if [[ "$target" != /* ]]; then
            target="$dir/$target"
        fi
        script="$target"
    done

    dir="$(cd -P "$(dirname "$script")" >/dev/null 2>&1 && pwd)"
    printf '%s/share/hamta/config.json\n' "$(dirname "$dir")"
}

init_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        echo "Config already exists at $CONFIG_FILE"
        exit 0
    fi
    mkdir -p "$CONFIG_DIR"
    local src
    src="$(default_config_src)"
    if [[ -f "$src" ]]; then
        cp "$src" "$CONFIG_FILE"
    else
        cat > "$CONFIG_FILE" <<'JSONEOF'
{
  "proxy": {
    "url": "http://127.0.0.1:1087",
    "mode": "env"
  },
  "verify": {
    "enabled": true,
    "expected_country": "JP"
  }
}
JSONEOF
    fi
    echo "Config created at $CONFIG_FILE"
    echo "Edit it to set your proxy URL and expected country."
}

show_config() {
    init_if_missing
    cat "$CONFIG_FILE"
}

config_invalid() {
    CONFIG_ERROR="$*"
    return 1
}

read_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        config_invalid "Config not found at $CONFIG_FILE. Run 'hamta init' first."
        return 1
    fi

    if ! jq empty "$CONFIG_FILE" >/dev/null 2>&1; then
        config_invalid "Config is not valid JSON: $CONFIG_FILE"
        return 1
    fi

    local proxy_type
    proxy_type="$(jq -r 'try (.proxy.url | type) catch "invalid"' "$CONFIG_FILE")"
    if [[ "$proxy_type" == "null" ]]; then
        config_invalid "proxy.url is not set in $CONFIG_FILE"
        return 1
    fi
    if [[ "$proxy_type" != "string" ]]; then
        config_invalid "proxy.url must be a non-empty string in $CONFIG_FILE"
        return 1
    fi

    PROXY_URL=$(jq -r '.proxy.url' "$CONFIG_FILE")
    if [[ -z "$PROXY_URL" || "$PROXY_URL" == "null" ]]; then
        config_invalid "proxy.url is not set in $CONFIG_FILE"
        return 1
    fi

    if [[ "$(jq -r 'try ((.proxy.mode // "env") | type) catch "invalid"' "$CONFIG_FILE")" != "string" ]]; then
        config_invalid "proxy.mode must be a string in $CONFIG_FILE"
        return 1
    fi

    PROXY_MODE=$(jq -r '.proxy.mode // "env"' "$CONFIG_FILE")
    case "$PROXY_MODE" in
        env|proxychains)
            ;;
        *)
            config_invalid "proxy.mode must be 'env' or 'proxychains' in $CONFIG_FILE"
            return 1
            ;;
    esac

    NO_PROXY_CONFIG=""
    local no_proxy_type
    no_proxy_type="$(jq -r 'try (.proxy.no_proxy | type) catch "invalid"' "$CONFIG_FILE")"
    case "$no_proxy_type" in
        null)
            ;;
        string)
            NO_PROXY_CONFIG="$(jq -r '.proxy.no_proxy' "$CONFIG_FILE")"
            ;;
        array)
            if [[ "$(jq -r '[.proxy.no_proxy[] | type] | all(. == "string")' "$CONFIG_FILE" 2>/dev/null)" != "true" ]]; then
                config_invalid "proxy.no_proxy array must contain only strings in $CONFIG_FILE"
                return 1
            fi
            NO_PROXY_CONFIG="$(jq -r '.proxy.no_proxy | join(",")' "$CONFIG_FILE")"
            ;;
        *)
            config_invalid "proxy.no_proxy must be a string or array of strings in $CONFIG_FILE"
            return 1
            ;;
    esac

    if [[ "$(jq -r 'try ((.verify.enabled // false) | type) catch "invalid"' "$CONFIG_FILE")" != "boolean" ]]; then
        config_invalid "verify.enabled must be true or false in $CONFIG_FILE"
        return 1
    fi

    VERIFY_ENABLED=$(jq -r '.verify.enabled // false' "$CONFIG_FILE")
    EXPECTED_COUNTRY=$(jq -r 'try (.verify.expected_country // empty) catch empty' "$CONFIG_FILE")

    if [[ "$VERIFY_ENABLED" == "true" ]]; then
        if [[ "$(jq -r 'try (.verify.expected_country | type) catch "invalid"' "$CONFIG_FILE")" != "string" || -z "$EXPECTED_COUNTRY" ]]; then
            config_invalid "verify.expected_country must be a non-empty string when verify.enabled is true in $CONFIG_FILE"
            return 1
        fi
    fi

    return 0
}

load_config() {
    if ! read_config; then
        die "$CONFIG_ERROR"
    fi
}

init_if_missing() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        die "Config not found at $CONFIG_FILE. Run 'hamta init' first."
    fi
}

build_no_proxy() {
    local combined="$DEFAULT_NO_PROXY"
    if [[ -n "${NO_PROXY_CONFIG:-}" ]]; then
        combined="$combined,$NO_PROXY_CONFIG"
    fi
    printf '%s' "$combined" \
        | tr ',' '\n' \
        | awk '{ gsub(/^[ \t]+|[ \t]+$/, ""); if (length($0) && !seen[$0]++) print }' \
        | paste -sd, -
}

set_proxy_env() {
    export ALL_PROXY="$PROXY_URL"
    export HTTP_PROXY="$PROXY_URL"
    export HTTPS_PROXY="$PROXY_URL"
    export http_proxy="$PROXY_URL"
    export https_proxy="$PROXY_URL"
    export npm_config_proxy="$PROXY_URL"
    export npm_config_https_proxy="$PROXY_URL"
    export NODE_USE_ENV_PROXY=1

    local no_proxy_val
    no_proxy_val="$(build_no_proxy)"
    export NO_PROXY="$no_proxy_val"
    export no_proxy="$no_proxy_val"
}

clear_proxy_env() {
    unset ALL_PROXY
    unset all_proxy
    unset HTTP_PROXY
    unset HTTPS_PROXY
    unset http_proxy
    unset https_proxy
    unset npm_config_proxy
    unset npm_config_https_proxy
    unset NPM_CONFIG_PROXY
    unset NPM_CONFIG_HTTPS_PROXY
    unset NODE_USE_ENV_PROXY
    unset NO_PROXY
    unset no_proxy
}

proxy_endpoint() {
    local endpoint="$PROXY_URL"
    endpoint="${endpoint#*://}"
    endpoint="${endpoint%%/*}"
    endpoint="${endpoint##*@}"
    printf '%s' "$endpoint"
}

proxy_auth() {
    local authority="$PROXY_URL"
    authority="${authority#*://}"
    authority="${authority%%/*}"
    if [[ "$authority" != *"@"* ]]; then
        return
    fi

    local credentials="${authority%@*}"
    local username="${credentials%%:*}"
    local password="${credentials#*:}"
    if [[ -z "$username" || -z "$password" || "$username" == "$password" ]]; then
        die "proxychains mode requires proxy credentials to use user:password format"
    fi
    printf ' %s %s' "$username" "$password"
}

proxychains_type() {
    local type="${PROXY_URL%%://*}"
    case "$type" in
        http|socks4|socks5)
            printf '%s' "$type"
            ;;
        socks5h)
            printf 'socks5'
            ;;
        *)
            die "proxychains mode requires proxy.url to start with http://, socks4://, socks5://, or socks5h://"
            ;;
    esac
}

proxychains_host_port() {
    local endpoint
    endpoint="$(proxy_endpoint)"
    if [[ "$endpoint" == "["*"]":* ]]; then
        local host="${endpoint%%]*}"
        host="${host#[}"
        local port="${endpoint##*:}"
        printf '%s %s' "$host" "$port"
        return
    fi

    local host="${endpoint%:*}"
    local port="${endpoint##*:}"
    if [[ -z "$host" || -z "$port" || "$host" == "$port" ]]; then
        die "proxychains mode requires proxy.url to include host and port"
    fi
    printf '%s %s' "$host" "$port"
}

to_localnet() {
    local entry="$1"
    entry="${entry#"${entry%%[![:space:]]*}"}"
    entry="${entry%"${entry##*[![:space:]]}"}"
    [[ -z "$entry" ]] && return 1

    if [[ "$entry" == *:* ]]; then
        local address="$entry"
        local prefix="128"
        if [[ "$entry" == */* ]]; then
            address="${entry%/*}"
            prefix="${entry##*/}"
            [[ "$prefix" =~ ^[0-9]+$ ]] || return 1
            (( 10#$prefix <= 128 )) || return 1
        fi

        [[ "$address" =~ ^[0-9A-Fa-f:]+$ ]] || return 1

        local compressed=0
        local left="$address"
        local right=""
        if [[ "$address" == *::* ]]; then
            [[ "${address#*::}" != *::* ]] || return 1
            compressed=1
            left="${address%%::*}"
            right="${address#*::}"
        elif [[ "$address" == :* || "$address" == *: ]]; then
            return 1
        fi

        local group
        local group_count=0
        local groups=()
        if [[ -n "$left" ]]; then
            IFS=':' read -r -a groups <<< "$left"
            for group in "${groups[@]}"; do
                [[ "$group" =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
                (( group_count += 1 ))
            done
        fi
        if [[ -n "$right" ]]; then
            IFS=':' read -r -a groups <<< "$right"
            for group in "${groups[@]}"; do
                [[ "$group" =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
                (( group_count += 1 ))
            done
        fi

        if (( compressed == 1 )); then
            (( group_count < 8 )) || return 1
        else
            (( group_count == 8 )) || return 1
        fi

        printf '%s/%s' "$address" "$prefix"
        return 0
    fi

    if [[ "$entry" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        printf '%s/255.255.255.255' "$entry"
        return 0
    fi

    if [[ "$entry" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9.]+$ ]]; then
        printf '%s' "$entry"
        return 0
    fi

    return 1
}

build_localnet() {
    local entry
    for entry in $DEFAULT_LOCALNET; do
        printf 'localnet %s\n' "$entry"
    done

    if [[ -z "${NO_PROXY_CONFIG:-}" ]]; then
        return
    fi

    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" ]] && continue
        if entry="$(to_localnet "$line")"; then
            printf 'localnet %s\n' "$entry"
        fi
    done < <(printf '%s\n' "$NO_PROXY_CONFIG" | tr ',' '\n')
}

require_proxychains() {
    if ! command -v proxychains4 &>/dev/null; then
        die "proxy.mode is proxychains, but proxychains4 was not found. Install proxychains-ng and try again."
    fi
}

apply_mode_override() {
    if [[ -n "$CLI_MODE_OVERRIDE" ]]; then
        case "$CLI_MODE_OVERRIDE" in
            env|proxychains)
                PROXY_MODE="$CLI_MODE_OVERRIDE"
                ;;
            *)
                die "--mode must be 'env' or 'proxychains'"
                ;;
        esac
    fi
}

cleanup_proxychains_config() {
    if [[ -n "$PROXYCHAINS_CONFIG" ]]; then
        rm -f "$PROXYCHAINS_CONFIG"
    fi
}

run_with_proxychains() {
    require_proxychains

    PROXYCHAINS_CONFIG="$(mktemp "${TMPDIR:-/tmp}/hamta-proxychains.XXXXXX")"
    trap cleanup_proxychains_config EXIT

    local proxy_type
    proxy_type="$(proxychains_type)"
    local host_port
    host_port="$(proxychains_host_port)"
    local auth
    auth="$(proxy_auth)"
    local localnet_block
    localnet_block="$(build_localnet)"

    cat > "$PROXYCHAINS_CONFIG" <<EOF
strict_chain
proxy_dns
quiet_mode
$localnet_block

[ProxyList]
$proxy_type $host_port$auth
EOF

    clear_proxy_env
    proxychains4 -f "$PROXYCHAINS_CONFIG" "$CMD" "$@"
}

verify_proxy() {
    local ip_info
    local check_expected="${1:-true}"
    if ! ip_info=$(curl -s --max-time 10 ipinfo.io); then
        die "Failed to reach ipinfo.io. Is the proxy running at $PROXY_URL?"
    fi

    local ip
    ip=$(echo "$ip_info" | jq -r '.ip // empty')

    local country
    country=$(echo "$ip_info" | jq -r '.country // empty')
    if [[ -z "$country" ]]; then
        die "Could not determine country from ipinfo.io response."
    fi

    if [[ "$check_expected" == "true" && "$country" != "$EXPECTED_COUNTRY" ]]; then
        die "${RED}Country mismatch:${NC} expected ${GREEN}$EXPECTED_COUNTRY${NC}, got ${RED}$country${NC}. Proxy may not be working."
    fi

    echo -e "Country: ${GREEN}$country${NC}"
    if [[ -n "$ip" ]]; then
        echo -e "${RED}Running with proxy $(proxy_endpoint); actual IP $ip${NC}"
    else
        echo -e "${RED}Running with proxy $(proxy_endpoint); actual IP unknown${NC}"
    fi
}

verify_command() {
    check_deps
    load_config
    apply_mode_override

    if [[ "$PROXY_MODE" == "proxychains" ]]; then
        require_proxychains
    fi

    set_proxy_env
    verify_proxy "$VERIFY_ENABLED"
}

doctor_proxy() {
    local failed=0
    local ip_info
    local ip
    local country

    set_proxy_env

    if ! ip_info=$(curl -s --max-time 10 ipinfo.io); then
        doctor_fail "proxy reachability: failed to reach ipinfo.io through $PROXY_URL"
        return 1
    fi

    ip=$(echo "$ip_info" | jq -r '.ip // empty')
    country=$(echo "$ip_info" | jq -r '.country // empty')

    if [[ -z "$country" ]]; then
        doctor_fail "current exit IP: could not determine country from ipinfo.io response"
        return 1
    fi

    doctor_ok "proxy reachability: reached ipinfo.io through $(proxy_endpoint)"
    if [[ -n "$ip" ]]; then
        doctor_ok "current exit IP: $ip"
    else
        doctor_warn "current exit IP: unknown"
    fi
    doctor_ok "current exit country: $country"

    if [[ "$VERIFY_ENABLED" == "true" && "$country" != "$EXPECTED_COUNTRY" ]]; then
        doctor_fail "country verification: expected $EXPECTED_COUNTRY, got $country"
        failed=1
    elif [[ "$VERIFY_ENABLED" == "true" ]]; then
        doctor_ok "country verification: expected $EXPECTED_COUNTRY"
    else
        doctor_warn "country verification: disabled"
    fi

    return "$failed"
}

doctor_command() {
    local failed=0
    local has_jq=0
    local has_curl=0
    local has_proxychains=0

    echo "hamta doctor"

    if command -v jq &>/dev/null; then
        doctor_ok "jq installed"
        has_jq=1
    else
        doctor_fail "jq missing"
        failed=1
    fi

    if command -v curl &>/dev/null; then
        doctor_ok "curl installed"
        has_curl=1
    else
        doctor_fail "curl missing"
        failed=1
    fi

    if command -v proxychains4 &>/dev/null; then
        doctor_ok "proxychains4 installed"
        has_proxychains=1
    else
        doctor_warn "proxychains4 missing; required only when proxy.mode is proxychains"
    fi

    if [[ "$has_jq" -ne 1 ]]; then
        doctor_fail "config validity: skipped because jq is missing"
        return 1
    fi

    if read_config; then
        doctor_ok "config valid: $CONFIG_FILE"
    else
        doctor_fail "config validity: $CONFIG_ERROR"
        return 1
    fi

    apply_mode_override

    if [[ "$PROXY_MODE" == "proxychains" && "$has_proxychains" -ne 1 ]]; then
        doctor_fail "proxychains4 required by proxy.mode=proxychains"
        failed=1
    fi

    if [[ "$has_curl" -ne 1 ]]; then
        doctor_fail "proxy reachability: skipped because curl is missing"
        return 1
    fi

    if ! doctor_proxy; then
        failed=1
    fi

    return "$failed"
}

CLI_MODE_OVERRIDE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            usage
            ;;
        --version|-v)
            echo "hamta $VERSION"
            exit 0
            ;;
        --mode)
            if [[ $# -lt 2 ]]; then
                die "--mode requires 'env' or 'proxychains'"
            fi
            CLI_MODE_OVERRIDE="$2"
            shift 2
            ;;
        --mode=*)
            CLI_MODE_OVERRIDE="${1#--mode=}"
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "Unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

if [[ -z "${1:-}" ]]; then
    usage
fi

if [[ -z "$CLI_MODE_OVERRIDE" ]]; then
    case "$1" in
        init)
            init_config
            exit 0
            ;;
        config)
            show_config
            exit 0
            ;;
    esac
fi

case "$1" in
    doctor)
        doctor_command
        exit
        ;;
    verify)
        verify_command
        exit
        ;;
esac

check_deps

load_config

apply_mode_override

if [[ -z "$PROXY_URL" || "$PROXY_URL" == "null" ]]; then
    die "proxy.url is not set in $CONFIG_FILE"
fi

CMD="$1"
shift

if ! command -v "$CMD" &>/dev/null; then
    die "Command not found: $CMD"
fi

if [[ "$PROXY_MODE" == "proxychains" ]]; then
    require_proxychains
fi

set_proxy_env

if [[ "$VERIFY_ENABLED" == "true" ]]; then
    verify_proxy
else
    echo -e "${RED}Running with proxy $(proxy_endpoint)${NC}"
fi

echo -e "Running ${CYAN}$CMD${NC}..."
if [[ "$PROXY_MODE" == "proxychains" ]]; then
    run_with_proxychains "$@"
else
    exec "$CMD" "$@"
fi
