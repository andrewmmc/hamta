#!/usr/bin/env bash
set -euo pipefail

VERSION="1.1.2"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hamta"
CONFIG_FILE="$CONFIG_DIR/config.json"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

usage() {
    cat <<EOF
hamta - Run commands through a proxy environment.

Usage: hamta <command> [args...]
       hamta --help
       hamta --version
       hamta config

Options:
  --help      Show this help message
  --version   Show version
  config      Print current configuration
  init        Create default config at ~/.config/hamta/config.json

Config file: ~/.config/hamta/config.json
EOF
    exit 0
}

die() {
    echo -e "${RED}Error:${NC} $*" >&2
    exit 1
}

warn() {
    echo -e "${YELLOW}Warning:${NC} $*" >&2
}

check_deps() {
    local missing=()
    if ! command -v jq &>/dev/null; then
        missing+=("jq")
    fi
    if ! command -v curl &>/dev/null; then
        missing+=("curl")
    fi
    if [[ ${#missing[@]} -gt 0 ]]; then
        die "Missing required dependencies: ${missing[*]}. Install them and try again."
    fi
}

default_config_src() {
    local script="$0"
    local dir
    local target

    if [[ "$script" != */* ]]; then
        script="$(command -v "$script")"
    fi

    while [[ -L "$script" ]]; do
        dir="$(cd -P "$(dirname "$script")" >/dev/null 2>&1 && pwd)"
        target="$(readlink "$script")"
        if [[ "$target" != /* ]]; then
            target="$dir/$target"
        fi
        script="$target"
    done

    dir="$(cd -P "$(dirname "$script")" >/dev/null 2>&1 && pwd)"
    printf '%s/share/hamta/config.json\n' "$(dirname "$dir")"
}

init_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        echo "Config already exists at $CONFIG_FILE"
        exit 0
    fi
    mkdir -p "$CONFIG_DIR"
    local src
    src="$(default_config_src)"
    if [[ -f "$src" ]]; then
        cp "$src" "$CONFIG_FILE"
    else
        cat > "$CONFIG_FILE" <<'JSONEOF'
{
  "proxy": {
    "url": "http://127.0.0.1:1087",
    "mode": "env"
  },
  "verify": {
    "enabled": true,
    "expected_country": "JP"
  }
}
JSONEOF
    fi
    echo "Config created at $CONFIG_FILE"
    echo "Edit it to set your proxy URL and expected country."
}

show_config() {
    init_if_missing
    cat "$CONFIG_FILE"
}

load_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        die "Config not found at $CONFIG_FILE. Run 'hamta init' first."
    fi

    if ! jq empty "$CONFIG_FILE" >/dev/null 2>&1; then
        die "Config is not valid JSON: $CONFIG_FILE"
    fi

    local proxy_type
    proxy_type="$(jq -r 'try (.proxy.url | type) catch "invalid"' "$CONFIG_FILE")"
    if [[ "$proxy_type" == "null" ]]; then
        die "proxy.url is not set in $CONFIG_FILE"
    fi
    if [[ "$proxy_type" != "string" ]]; then
        die "proxy.url must be a non-empty string in $CONFIG_FILE"
    fi

    PROXY_URL=$(jq -r '.proxy.url' "$CONFIG_FILE")

    if [[ "$(jq -r 'try ((.proxy.mode // "env") | type) catch "invalid"' "$CONFIG_FILE")" != "string" ]]; then
        die "proxy.mode must be a string in $CONFIG_FILE"
    fi

    PROXY_MODE=$(jq -r '.proxy.mode // "env"' "$CONFIG_FILE")
    case "$PROXY_MODE" in
        env|proxychains)
            ;;
        *)
            die "proxy.mode must be 'env' or 'proxychains' in $CONFIG_FILE"
            ;;
    esac

    if [[ "$(jq -r 'try ((.verify.enabled // false) | type) catch "invalid"' "$CONFIG_FILE")" != "boolean" ]]; then
        die "verify.enabled must be true or false in $CONFIG_FILE"
    fi

    VERIFY_ENABLED=$(jq -r '.verify.enabled // false' "$CONFIG_FILE")
    EXPECTED_COUNTRY=$(jq -r 'try (.verify.expected_country // empty) catch empty' "$CONFIG_FILE")

    if [[ "$VERIFY_ENABLED" == "true" ]]; then
        if [[ "$(jq -r 'try (.verify.expected_country | type) catch "invalid"' "$CONFIG_FILE")" != "string" || -z "$EXPECTED_COUNTRY" ]]; then
            die "verify.expected_country must be a non-empty string when verify.enabled is true in $CONFIG_FILE"
        fi
    fi
}

init_if_missing() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        die "Config not found at $CONFIG_FILE. Run 'hamta init' first."
    fi
}

set_proxy_env() {
    export ALL_PROXY="$PROXY_URL"
    export HTTP_PROXY="$PROXY_URL"
    export HTTPS_PROXY="$PROXY_URL"
    export http_proxy="$PROXY_URL"
    export https_proxy="$PROXY_URL"
    export npm_config_proxy="$PROXY_URL"
    export npm_config_https_proxy="$PROXY_URL"
    export NODE_USE_ENV_PROXY=1
}

clear_proxy_env() {
    unset ALL_PROXY
    unset all_proxy
    unset HTTP_PROXY
    unset HTTPS_PROXY
    unset http_proxy
    unset https_proxy
    unset npm_config_proxy
    unset npm_config_https_proxy
    unset NPM_CONFIG_PROXY
    unset NPM_CONFIG_HTTPS_PROXY
    unset NODE_USE_ENV_PROXY
}

proxy_endpoint() {
    local endpoint="$PROXY_URL"
    endpoint="${endpoint#*://}"
    endpoint="${endpoint%%/*}"
    endpoint="${endpoint##*@}"
    printf '%s' "$endpoint"
}

proxy_auth() {
    local authority="$PROXY_URL"
    authority="${authority#*://}"
    authority="${authority%%/*}"
    if [[ "$authority" != *"@"* ]]; then
        return
    fi

    local credentials="${authority%@*}"
    local username="${credentials%%:*}"
    local password="${credentials#*:}"
    if [[ -z "$username" || -z "$password" || "$username" == "$password" ]]; then
        die "proxychains mode requires proxy credentials to use user:password format"
    fi
    printf ' %s %s' "$username" "$password"
}

proxychains_type() {
    local type="${PROXY_URL%%://*}"
    case "$type" in
        http|socks4|socks5)
            printf '%s' "$type"
            ;;
        socks5h)
            printf 'socks5'
            ;;
        *)
            die "proxychains mode requires proxy.url to start with http://, socks4://, socks5://, or socks5h://"
            ;;
    esac
}

proxychains_host_port() {
    local endpoint
    endpoint="$(proxy_endpoint)"
    if [[ "$endpoint" == "["*"]":* ]]; then
        local host="${endpoint%%]*}"
        host="${host#[}"
        local port="${endpoint##*:}"
        printf '%s %s' "$host" "$port"
        return
    fi

    local host="${endpoint%:*}"
    local port="${endpoint##*:}"
    if [[ -z "$host" || -z "$port" || "$host" == "$port" ]]; then
        die "proxychains mode requires proxy.url to include host and port"
    fi
    printf '%s %s' "$host" "$port"
}

require_proxychains() {
    if ! command -v proxychains4 &>/dev/null; then
        die "proxy.mode is proxychains, but proxychains4 was not found. Install proxychains-ng and try again."
    fi
}

run_with_proxychains() {
    require_proxychains

    local proxychains_config
    proxychains_config="$(mktemp "${TMPDIR:-/tmp}/hamta-proxychains.XXXXXX")"
    trap "rm -f '$proxychains_config'" EXIT

    local proxy_type
    proxy_type="$(proxychains_type)"
    local host_port
    host_port="$(proxychains_host_port)"
    local auth
    auth="$(proxy_auth)"

    cat > "$proxychains_config" <<EOF
strict_chain
proxy_dns
quiet_mode

[ProxyList]
$proxy_type $host_port$auth
EOF

    clear_proxy_env
    proxychains4 -f "$proxychains_config" "$CMD" "$@"
}

verify_proxy() {
    echo -e "${CYAN}HTTP_PROXY${NC}  $HTTP_PROXY"
    echo -e "${CYAN}HTTPS_PROXY${NC} $HTTPS_PROXY"
    echo ""

    echo -e "Running IP check via ${CYAN}ipinfo.io${NC}..."
    local ip_info
    if ! ip_info=$(curl -s --max-time 10 ipinfo.io); then
        die "Failed to reach ipinfo.io. Is the proxy running at $PROXY_URL?"
    fi

    echo "$ip_info"

    local ip
    ip=$(echo "$ip_info" | jq -r '.ip // empty')

    local country
    country=$(echo "$ip_info" | jq -r '.country // empty')
    if [[ -z "$country" ]]; then
        die "Could not determine country from ipinfo.io response."
    fi

    if [[ "$country" != "$EXPECTED_COUNTRY" ]]; then
        die "${RED}Country mismatch:${NC} expected ${GREEN}$EXPECTED_COUNTRY${NC}, got ${RED}$country${NC}. Proxy may not be working."
    fi

    echo -e "  Country: ${GREEN}$country${NC} ✓"
    if [[ -n "$ip" ]]; then
        echo -e "${RED}Running with proxy $(proxy_endpoint); actual IP $ip ($country)${NC}"
    else
        echo -e "${RED}Running with proxy $(proxy_endpoint); actual IP unknown (country $country)${NC}"
    fi
}

check_deps

case "${1:-}" in
    --help|-h)
        usage
        ;;
    --version|-v)
        echo "hamta $VERSION"
        exit 0
        ;;
    init)
        init_config
        exit 0
        ;;
    config)
        show_config
        exit 0
        ;;
    "")
        usage
        ;;
esac

load_config

if [[ -z "$PROXY_URL" || "$PROXY_URL" == "null" ]]; then
    die "proxy.url is not set in $CONFIG_FILE"
fi

CMD="$1"
shift

if ! command -v "$CMD" &>/dev/null; then
    die "Command not found: $CMD"
fi

if [[ "$PROXY_MODE" == "proxychains" ]]; then
    require_proxychains
fi

set_proxy_env

if [[ "$VERIFY_ENABLED" == "true" ]]; then
    verify_proxy
else
    echo -e "${RED}Running with proxy $(proxy_endpoint)${NC}"
fi

echo -e "Running ${CYAN}$CMD${NC}..."
if [[ "$PROXY_MODE" == "proxychains" ]]; then
    run_with_proxychains "$@"
else
    exec "$CMD" "$@"
fi
